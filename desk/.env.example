# Copy to .env (never commit it). Ask before adding any key.
# Judge service only — no bot process ever receives JEV_API_KEY.
JEV_API_KEY=
JEV_MODEL=jev-1.13.0          # exact version; never jev-latest
JEV_BASE_URL=                 # leave blank for the default; verify against TypeSafe's official docs
JEV_MOCK=1                    # 1 = deterministic mock backend, no network
JUDGE_HOST=127.0.0.1
JUDGE_PORT=8787

# Shared between bots and the judge. ≥32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DESK_SECRET=

# Bots
JUDGE_URL=http://127.0.0.1:8787   # unset = in-process mock judge
DESK_MODE=shadow                  # shadow | paper   (live does not exist in this skeleton)
DESK_TICKS=0                      # 0 = run until stopped
DESK_LOG_DIR=
